# jarvis-hermes — optional environment variables
#
# Copy to `.env` (gitignored) or export in your shell profile.
# Nothing here is required; the pipeline runs fully without any of these.

# Hugging Face token — raises API rate limits and speeds up first-time model
# downloads. Without it you may see "unauthenticated requests" warnings,
# which are harmless.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
